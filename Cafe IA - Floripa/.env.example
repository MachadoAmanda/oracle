# Copie para .env
DB_USER=ADMIN
DB_PASSWORD=
# A wallet do Autonomous
DB_DSN=
WALLET_DIR="C:/"
WALLET_PASSWORD=
# Autenticação por assinatura IAM, conforme main.py da pasta indicada.
LLM_AUTH=OCI_IAM
OCI_CONFIG_FILE="~/.oci/config"
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
LLM_MODEL=oci/google.gemini-2.5-flash
LLM_MODEL_COMPLEXO=oci/openai.gpt-oss-20b
# Alternativa: LLM_AUTH=OPENAI_COMPATIBLE, modelos com prefixo openai/
# Endpoint dos modelos: independente da região do banco.
LLM_API_BASE=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
LLM_API_KEY=
